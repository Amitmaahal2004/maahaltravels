# MongoDB Connection String (Atlas or local replica)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/travel_crm?retryWrites=true&w=majority
MONGODB_DB=travel_crm

# Application Base URL
APP_URL=http://localhost:3000

# Authentication Secret (Used for cryptographic hashing / sessions)
AUTH_SECRET=super_secret_enterprise_travel_crm_key_minimum_32_chars_long

# Node Environment
NODE_ENV=development

# Initial Admin Seed Credentials (Optional overrides for scripts/seed.ts)
ADMIN_EMAIL=admin@travelagency.com
ADMIN_PASSWORD=Password@123

# SMTP Email Configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_user
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=Travel Agency <no-reply@travelagency.com>

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

